# Kisan Suvidha Global Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials

PROJECT_NAME="Kisan Suvidha"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"

# Security (JWT)
SECRET_KEY="dev_secret_key_change_in_production_32bytes_min"

# Database & Cache Storage
DATABASE_URL="sqlite+aiosqlite:///./kisan_suvidha_dev.db"
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Twilio SMS API Gateway Integrations
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+18005550199"

# Fast2SMS Provider Alternative (India Regional SMS)
FAST2SMS_API_KEY="your_fast2sms_api_key_here"

# WhatsApp Business / Meta Cloud API Integrations
WHATSAPP_PHONE_NUMBER_ID="10060934638xxxx"
WHATSAPP_ACCESS_TOKEN="EAAGxxxxxxxxxxxxxxxxxxxxxxxx"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="kisan_suvidha_verify_token_2026"

# Frontend Public URLs (Use public domain in production, e.g. https://api.kisansuvidha.gov.in)
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_WS_URL="localhost:8000"

