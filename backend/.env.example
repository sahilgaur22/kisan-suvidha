# Kisan Suvidha Backend Environment Configuration

PROJECT_NAME="Kisan Suvidha"
ENVIRONMENT="development"
SECRET_KEY="dev_secret_key_change_in_production_32bytes_min"

# PostgreSQL Database (Supabase / Neon / Local Postgres)
DATABASE_URL="postgresql+asyncpg://postgres:postgrespassword@localhost:5432/kisan_suvidha"

# Redis Cache & Celery Broker
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/1"
CELERY_RESULT_BACKEND="redis://localhost:6379/2"

# Twilio SMS & WhatsApp Cloud API Credentials
TWILIO_ACCOUNT_SID="your_twilio_account_sid"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_PHONE_NUMBER="+1234567890"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token"
